                                    <div class="col-md-6" style="padding-left: 0px;">
                                        <div class="form-group">
                                            <label for="ngaylapPN">Ngày lập phiếu</label>
                                            <input type="date" class="form-control" name="NGAYLAPPN" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>
                                    <div class="col-md-6" style="padding-right: 0px;">
                                        <div class="form-group">
                                            <label for="tinhtrangTT">Tình trạng thanh toán</label>
                                            <select class="form-control" name="TINHTRANGTT" @(ViewBag.CoChiTietPN == true ? "" : "disabled")>
                                                <option value="0">Chưa thanh toán</option>
                                                <option value="1">Đã thanh toán</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="col-md-6" style="padding-left: 0px;">
                                        <div class="form-group">
                                            <Label>Nhà cung cấp</Label>
                                            <select name="MANCC" class="form-control">
                                                <option value="">[--Chọn nhà cung cấp--]</option>
                                                @foreach (var ncc in ViewBag.DanhSachNCC)
                                                {
                                                    <option value="@ncc.mancc">@ncc.tenncc</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-6" style="padding-right: 0px;">
                                        <div class="form-group">
                                            <label for="maNV">Nhân viên</label>
                                            <select name="MANV" class="form-control">
                                                <option value="">[--Chọn nhân viên--]</option>
                                                @foreach (var nv in ViewBag.DanhSachNV)
                                                {
                                                    <option value="@nv.MaNV">@nv.TenNV</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                </div>

                                <!-- Thêm các input field ẩn để nhận giá trị từ JavaScript binding -->
                                <div class="col-md-12" style="display: none;">
                                    <input type="text" id="maSP" name="MaSP" class="form-control" />
                                    <input type="text" id="giaNhap" name="GiaNhap" class="form-control" />
                                    <input type="text" id="soLuong" name="SoLuong" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>

        <!-- Bảng dữ liệu (nếu có) -->
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered" id="tbl_ctpn">
                                <!-- Nội dung bảng sẽ được thêm vào nếu cần -->
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Click_CTPN {
    <script type="text/javascript">
        $(function () {
            $('#tbl_ctpn tr').click(function (e) {
                var masp = $(this).closest('.onRow').find('td:nth-child(2)').text();
                var gianhap = $(this).closest('.onRow').find('td:nth-child(4)').text();
                var sl = $(this).closest('.onRow').find('td:nth-child(5)').text();

                // Sửa lại các ID để thống nhất với CTPN.cshtml
                $('#maSP').val(masp);
                $('#giaNhap').val(gianhap);
                $('#soLuong').val(sl);
            });
        });
    </script>
}
