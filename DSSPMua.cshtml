@model List<object>
@{
    ViewData["Title"] = "Sản phẩm đã mua";
    List<object> ListSP = ViewData["ListSP"] as List<object>;
    long SoLuong = 0;
    long Gia = 0;
}

<!-- FontAwesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>

<div class="container" style="display: flex; max-width: 1200px; margin: 40px auto 0 auto; gap: 32px; min-height: 450px;">
    <!-- SIDEBAR #này tui hong biết mn xài giống này không nên hong bỏ vô style.css -->
    <div class="sidebar" style="width:320px; border:1px solid #e9eff1; border-radius:4px; background:#fff; display:flex; flex-direction:column;">
        <a href="#" style="display:flex;align-items:center;gap:18px;padding:20px 30px;border-bottom:1px solid #e9eff1;color:#222;font-size:18px;text-decoration:none;font-weight:500;">
            <i class="fa fa-user"></i>Thông tin cá nhân
        </a>
        <a href="#" style="display:flex;align-items:center;gap:18px;padding:20px 30px;border-bottom:1px solid #e9eff1;color:#222;font-size:18px;text-decoration:none;font-weight:500;">
            <i class="fa fa-user-edit"></i>Quản lý đơn hàng cá nhân
        </a>
        <a href="#" class="selected" style="display:flex;align-items:center;gap:18px;padding:20px 30px;border-bottom:1px solid #e9eff1;background:#13704c;color:#fff;font-size:18px;text-decoration:none;font-weight:500;">
            <i class="fa fa-briefcase"></i>Sản phẩm đã mua
        </a>
    </div>
    <!-- MAIN TABLE -->
    <div style="flex:1; background:#fff; padding:20px 0 0 0;">
        <h2 style="font-size:32px; font-weight:600; margin-top:0; margin-bottom:18px;">Sản phẩm đã mua</h2>
        <table style="width:100%; border-collapse:collapse; margin-bottom:22px;">
            <thead>
                <tr>
                    <th style="border:1px solid #e9eff1;padding:12px 18px;background:#f4f6f5;font-weight:600;">Hình ảnh sản phẩm</th>
                    <th style="border:1px solid #e9eff1;padding:12px 18px;background:#f4f6f5;font-weight:600;">Sản phẩm</th>
                    <th style="border:1px solid #e9eff1;padding:12px 18px;background:#f4f6f5;font-weight:600;">Giá</th>
                    <th style="border:1px solid #e9eff1;padding:12px 18px;background:#f4f6f5;font-weight:600;">Số lượng</th>
                    <th style="border:1px solid #e9eff1;padding:12px 18px;background:#f4f6f5;font-weight:600;">Xem chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (ListSP != null && ListSP.Count > 0)
                {
                    foreach (var ctsp in ListSP)
                    {
                        // Lấy thông tin sản phẩm
                        string maTTSP = ctsp.GetType().GetProperty("MaTTSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string maLoaiSP = ctsp.GetType().GetProperty("MaLoaiSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string tenSP = ctsp.GetType().GetProperty("TenSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string tenTH = ctsp.GetType().GetProperty("TenTH")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string khoiLuong = ctsp.GetType().GetProperty("KhoiLuong")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string xuatXu = ctsp.GetType().GetProperty("XuatXu")?.GetValue(ctsp, null)?.ToString() ?? "";
                        string hinhAnh = ctsp.GetType().GetProperty("HinhAnh")?.GetValue(ctsp, null)?.ToString() ?? "";

                        if (long.TryParse(ctsp.GetType().GetProperty("GiaKM")?.GetValue(ctsp, null)?.ToString(), out long giaKM) && giaKM > 0)
                            Gia = giaKM;
                        else
                            Gia = long.TryParse(ctsp.GetType().GetProperty("Gia")?.GetValue(ctsp, null)?.ToString(), out long gia) ? gia : 0;

                        SoLuong = long.TryParse(ctsp.GetType().GetProperty("SoLuong")?.GetValue(ctsp, null)?.ToString(), out long soLuong) ? soLuong : 0;
                <tr>
                    <!-- Hình ảnh sản phẩm -->
                    <td style="border:1px solid #e9eff1;padding:12px 18px; text-align:center;">
                        <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP">
                            <img width="90" height="90" alt="Product Image" src="@hinhAnh" style="object-fit:contain;" />
                        </a>
                    </td>
                    <!-- Thông tin sản phẩm -->
                    <td style="border:1px solid #e9eff1;padding:12px 18px;">
                        <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP" style="font-weight:600;color:#13704c;text-decoration:none;">
                            @tenSP
                        </a>
                        <div style="font-size:15px;color:#666">
                            @tenTH - @khoiLuong kg - @xuatXu
                        </div>
                    </td>
                    <!-- Giá -->
                    <td style="border:1px solid #e9eff1;padding:12px 18px;">
                        <span class="amount">@string.Format("{0:0,0 đ}", Gia)</span>
                    </td>
                    <!-- Số lượng -->
                    <td style="border:1px solid #e9eff1;padding:12px 18px;">
                        @SoLuong
                    </td>
                    <!-- Xem chi tiết (icon con mắt) -->
                    <td style="border:1px solid #e9eff1;padding:12px 18px; text-align:center;">
                        <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP" title="Xem chi tiết" style="display:inline-block;background:#e4572e;border-radius:50%;width:38px;height:38px;line-height:38px;color:#fff;text-align:center;font-size:20px;">
                            <i class="fa fa-eye"></i>
                        </a>
                    </td>
                </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;color:#888;padding:30px;">Không có sản phẩm đã mua.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>