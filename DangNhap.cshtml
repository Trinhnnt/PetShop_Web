@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Chỉ giữ lại style cho form đăng nhập */
    .single-product-area {
        background: #f6f7fb;
        padding: 40px 0;
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-box {
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        padding: 60px 80px; /* Điều chỉnh padding ngang */
        margin: 20px auto;
        max-width: 950px; /* Tăng chiều rộng tối đa của khung form */
        width: 100%;
        border-top: 5px solid var(--primary-color);
        transition: all 0.3s ease;
        text-align: center;
        position: relative;
    }

        .login-box:hover {
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.15);
            transform: translateY(-5px);
        }

    .login-icon {
        font-size: 80px; /* Tăng kích thước logo */
        color: var(--primary-color);
        margin-bottom: 30px; /* Tăng khoảng cách logo và tiêu đề */
    }

    .form-header {
        color: var(--text-color);
        font-size: 32px; /* Tăng kích thước tiêu đề */
        margin-bottom: 20px; /* Tăng khoảng cách tiêu đề và subtitle */
        font-weight: 700;
    }

    .login-subtitle {
        color: var(--primary-color);
        font-size: 18px; /* Tăng kích thước subtitle */
        margin-bottom: 30px; /* Tăng khoảng cách subtitle và form */
    }

    .elegant-hr {
        border: 0;
        height: 1px;
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0), var(--primary-color), rgba(0, 0, 0, 0));
        margin: 30px auto;
        width: 80%;
    }

    .floating-label-group {
        position: relative;
        display: block;
        width: 100%;
        max-width: 790px; /* Tăng chiều rộng tối đa của nhóm input (950 - 80*2 = 790) */
        margin: 0 auto 25px;
        color: var(--primary-color);
    }

    .form-control {
        width: 100%;
        height: 60px;
        padding: 16px;
        font-size: 18px;
        border-radius: 8px;
        border: 2px solid var(--border-color);
        background: #f9fafc;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            background: #fff;
            box-shadow: 0 0 8px rgba(13, 142, 120, 0.4);
        }

            .form-control:focus + .floating-label,
            .form-control:not(:placeholder-shown) + .floating-label {
                top: -8px;
                left: 10px;
                font-size: 12px;
                color: var(--primary-color);
                background: #fff;
                padding: 0 5px;
                opacity: 1;
                pointer-events: none;
            }

    .floating-label {
        position: absolute;
        top: 18px;
        left: 16px;
        color: var(--primary-color);
        font-size: 15px;
        transition: all 0.2s ease;
        background-color: transparent;
        padding: 0 5px;
        pointer-events: none;
    }

    .checkbox {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 30px;
        max-width: 790px; /* Tăng chiều rộng tối đa của checkbox */
        margin-left: auto;
        margin-right: auto;
    }

        .checkbox label {
            color: var(--primary-color);
            font-weight: 500;
            display: block;
            width: 100%;
        }

    .btn-container {
        margin-top: 10px;
        max-width: 790px; /* Tăng chiều rộng tối đa của container nút */
        margin-left: auto;
        margin-right: auto;
    }

    .btn-login {
        width: 100%;
        background: var(--primary-color) !important;
        border: none;
        border-radius: 40px;
        padding: 18px 0; /* Tăng padding nút đăng nhập */
        font-size: 20px; /* Tăng kích thước chữ nút đăng nhập */
        font-weight: 700;
        color: #fff;
        letter-spacing: 1px;
        box-shadow: 0 5px 15px rgba(13, 142, 120, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-login:hover {
            background: var(--primary-color-dark) !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(13, 142, 120, 0.4);
        }

        .btn-login i {
            margin-right: 10px;
        }

    .register-now {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid var(--border-color);
        text-align: center;
    }

        .register-now p {
            color: var(--light-text);
            margin-bottom: 10px;
        }

    .btn-register-link {
        color: #fff;
        background: var(--primary-color);
        padding: 12px 30px; /* Tăng padding nút đăng ký */
        border-radius: 30px;
        font-size: 16px; /* Tăng kích thước chữ nút đăng ký */
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(13, 142, 120, 0.3);
    }

        .btn-register-link:hover {
            background: var(--primary-color-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(13, 142, 120, 0.4);
            text-decoration: none;
        }

    .alert-danger {
        background-color: #fff5f7;
        color: #ff3860;
        border-left: 4px solid #ff3860;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 15px;
        font-weight: 500;
        text-align: center;
        max-width: 790px; /* Tăng chiều rộng tối đa của thông báo lỗi */
        margin-left: auto;
        margin-right: auto;
    }

        .alert-danger i {
            margin-right: 8px;
        }

    @@media (max-width: 768px) {
        .login-box

    {
        padding: 40px 50px; /* Giảm padding cho màn hình nhỏ */
        margin: 10px;
    }

    .login-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .form-header {
        font-size: 26px;
        margin-bottom: 15px;
    }

    .login-subtitle {
        font-size: 16px;
        margin-bottom: 25px;
    }

    .form-control {
        height: 55px;
        font-size: 18px;
        padding: 15px;
    }

    .btn-login {
        padding: 15px 0;
        font-size: 18px;
    }

    .btn-register-link {
        padding: 10px 25px;
        font-size: 15px;
    }

    .alert-danger {
        padding: 15px;
        font-size: 15px;
    }

    }</style>

<div class="single-product-area">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="login-box">
                    <div class="login-icon">
                        <i class="fa fa-user-circle"></i>
                    </div>
                    <h2 class="form-header">Đăng nhập</h2>
                    <p class="login-subtitle">Chào mừng bạn đến với PETSHOP</p>
                    <hr class="elegant-hr" />
                    @if (ViewBag.check != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fa fa-exclamation-circle"></i> @ViewBag.check
                        </div>
                    }
                    <form action="/TaiKhoan/KTDangNhap" method="post" class="dangnhap">
                        <div class="form-group">
                            <div class="floating-label-group">
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="email"
                                       placeholder=" "
                                       required />
                                <label class="floating-label" for="email"><i class="fa fa-envelope"></i> Email</label>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="floating-label-group">
                                <input type="password"
                                       class="form-control"
                                       id="pwd"
                                       name="pwd"
                                       placeholder=" "
                                       required />
                                <label class="floating-label" for="pwd"><i class="fa fa-lock"></i> Mật khẩu</label>
                            </div>
                        </div>
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" /> Ghi nhớ đăng nhập
                            </label>
                        </div>
                        <div class="btn-container">
                            <button type="submit" class="btn btn-login">
                                <i class="fa fa-sign-in"></i> Đăng nhập
                            </button>
                        </div>
                    </form>
                    <div class="register-now">
                        <p>Chưa có tài khoản?</p>
                        <a href="/TaiKhoan/DangKi" class="btn-register-link">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
