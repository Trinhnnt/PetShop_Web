@model List<Web_projectframeword_admin.Models.NhanVien>
@{
    int stt = 0;
}

<div class="content-wrapper" style="min-height: 639px;">
    <section class="content">
        <!-- Small boxes (Stat box) -->
        <div class="row">
            <div class="col-lg-3 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-aqua">
                    <div class="inner">
                        <h3>1</h3>
                        <p>Khách hàng</p>
                        <div class="icon">
                            <i class="ion ion-cash"></i>
                        </div>
                    </div>
                    <a href="/Admin/ThongKe/DSKH" class="small-box-footer">Các khách hàng mua nhiều nhất</a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-green">
                    <div class="inner">
                        <h3>2</h3>
                        <p>Sản phẩm</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-stats-bars"></i>
                    </div>
                    <a href="/Admin/ThongKe/DSSP" class="small-box-footer">Những sản phẩm bán chạy nhất</a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-yellow">
                    <div class="inner">
                        <h3>3</h3>
                        <p>Nhân viên</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-person"></i>
                    </div>
                    <a href="/Admin/ThongKe/NhanVienThongKe" class="small-box-footer">Thống kê nhân viên</a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-xs-6">
                <!-- small box Thống kê mua hàng & chi phí -->
                <div class="small-box bg-red">
                    <div class="inner">
                        <h3>4</h3>
                        <p>Doanh thu</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-pie-graph"></i>
                    </div>
                    <a href="/Admin/ThongKe/Index" class="small-box-footer">Thống kê doanh thu</a>
                </div>
            </div>
            <!-- ./col -->
            <!-- ./col -->
            <div class="col-lg-3 col-xs-6">
                <!-- small box Thống kê mua hàng & chi phí -->
                <div class="small-box bg-red">
                    <div class="inner">
                        <h3>5</h3>
                        <p>Chi phí</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-pie-graph"></i>
                    </div>
                    <a href="/Admin/ThongKe/ChiPhi" class="small-box-footer">Thống kê chi phí</a>
                </div>
            </div>
            <!-- ./col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.Data -->
    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box" id="view">
                    <div class="box-header with-border">
                        <div class="box-body">
                            <div class="row" style="padding:0px; margin:0px;">
                                <div class="table-responsive">
                                    <div class="box-header with-border">
                                        <h3 class="fa fa-chart-bar"> Danh sách nhân viên</h3>
                                        <div class="bread_crumb">
                                        </div>
                                    </div>
                                    <table class="table table-hover table-bordered">
                                        <thead>
                                            <tr>
                                                <th class="text-center">STT</th>
                                                <th>Mã NV</th>
                                                <th>Tên nhân viên</th>
                                                <th>Ngày vào làm</th>
                                                <th>Lương</th>
                                                <th>Số điện thoại</th>
                                                <th>Email</th>
                                                <th>Địa chỉ</th>
                                                <th>Loại nhân viên</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Count() > 0)
                                            {
                                                @foreach (var item in Model)
                                                {
                                                    stt += 1;
                                                    <tr>
                                                        <td class="text-center">@stt</td>
                                                        <td>@item.MaNV</td>
                                                        <td>@item.TenNV</td>
                                                        <td>@item.NgayVL.ToString("dd/MM/yyyy")</td>
                                                        <td>@string.Format("{0:0,0 VNĐ}", item.Luong)</td>
                                                        <td>@item.SDT</td>
                                                        <td>@item.Email</td>
                                                        <td>@item.DiaChi</td>
                                                        <td>@item.LoaiNV</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 text-center">
                                        <ul class="pagination">
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
