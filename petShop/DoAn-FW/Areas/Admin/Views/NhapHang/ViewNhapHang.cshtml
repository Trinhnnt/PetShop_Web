@using Web_projectframeword_admin.Models;
@model NhapHang
@section Click_CTPN{
    <script type="text/javascript">
        $(function () {
            $('#tbl_ctpn tr').click(function (e) {
                var masp = $(this).closest('.onRow').find('td:nth-child(2)').text();
                var gianhap = $(this).closest('.onRow').find('td:nth-child(4)').text();
                var sl = $(this).closest('.onRow').find('td:nth-child(5)').text();
                $('#spSL').val(masp);
                $('#gnIP').val(gianhap);
                $('#slIP').val(sl);
            });
        });
    </script>
}
@{
    <div class="content-wrapper" style="min-height: 639px;">
        <form action="/Admin/NhapHang/UpdateNhapHang" method="post">
            <section class="content-header">
                <h1><i class="glyphicon glyphicon-ok-sign"></i> Thêm phiếu nhập mới</h1>
                <div class="breadcrumb">
                    <a class="btn btn-primary btn-sm">
                        Update
                        <button type="submit" style="width: 50px; height: 25px; background-color: darkcyan; border-radius: 10px; color: white; border-color: white; ">
                            <i class="glyphicon glyphicon-floppy-save"></i>
                        </button>
                    </a>
                    <a class="btn btn-primary btn-sm" href="/Admin/NhapHang/LietKeNhapHang" role="button">
                        <span class="glyphicon glyphicon-remove do_nos"></span> Thoát
                    </a>
                </div>
            </section>
            <!-- Main content -->
            <section class="content">
                <div class="row">
                    <div class="col-md-12">
                        <div class="box" id="view">
                            <div class="box-body">
                                <div class="col-md-12">
                                    <div class="col-md-6" style="padding-left: 0px;">
                                        <div class="form-group">
                                            <label for="maPN">Mã phiếu nhập</label>
                                            <input type="number" readonly class="form-control" name="MAPN" value="@Model.MAPN">
                                        </div>
                                    </div>
                                    <div class="col-md-6" style="padding-right: 0px;">
                                        <div class="form-group">
                                            <label for="tongtienTT">Tổng tiền thanh toán</label>
                                            <input type="number" readonly class="form-control" name="TONGTIENTT" min="0" step="5000" style="width:100%" value="@Model.TONGTIENTT">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="col-md-6" style="padding-left: 0px;">
                                        <div class="form-group">
                                            <label for="ngaylapPN">Ngày lập phiếu</label>
                                            <input type="date" readonly class="form-control" name="NGAYLAPPN" value="@Model.NGAYLAPPN.Date.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>
                                    <div class="col-md-6" style="padding-right: 0px;">
                                        <div class="form-group">
                                            <label>Tình trạng thanh toán</label>
                                            <select class="form-control" name="TINHTRANGTT">
                                                @{ 
                                                    if (Model.TINHTRANGTT == 0)
                                                    {
                                                        <option value="0" selected>Chưa thanh toán</option>
                                                        <option value="1">Đã thanh toán</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="0">Chưa thanh toán</option>
                                                        <option value="1" selected>Đã thanh toán</option>
                                                    }
                                                 }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="col-md-6" style="padding-left: 0px;">
                                        <div class="form-group">
                                            <Label>Nhà cung cấp</Label>
                                            <select name="MANCC" class="form-control">
                                                <option value="">[--Chọn nhà cung cấp--]</option>
                                                @if (ViewBag.DanhSachNCC != null)
                                                {
                                                    @foreach (var ncc in ViewBag.DanhSachNCC)
                                                    {
                                                        if (Model.MANCC == ncc.mancc)
                                                        {
                                                            <option value="@ncc.mancc" selected>@ncc.tenncc</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@ncc.mancc">@ncc.tenncc</option>
                                                        }
                                                    }
                                                }
                                            </select>

                                        </div>
                                    </div>
                                    <div class="col-md-6" style="padding-right: 0px;">
                                        <div class="form-group">
                                            <label>Nhân viên</label>
                                            <select name="MANV" class="form-control">
                                                <option value="">[--Chọn nhân viên--]</option>
                                                @if (ViewBag.DanhSachNV != null)
                                                {
                                                    @foreach (var nv in ViewBag.DanhSachNV)
                                                    {
                                                        if (Model.MANV == nv.MaNV)
                                                        {
                                                            <option value="@nv.MaNV" selected>@nv.TenNV</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@nv.MaNV">@nv.TenNV</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>
    </div>
}
