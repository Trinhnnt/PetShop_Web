@model Web_projectframeword_admin.Models.HoTro
@{
    ViewData["Title"] = "Xác nhận xóa bình luận";
}

<div class="content-wrapper" style="min-height: 639px;">
    <section class="content-header">
        <h1><i class="glyphicon glyphicon-trash"></i> Xác nhận xóa bình luận</h1>
    </section>
    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box" id="view">
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="alert alert-warning">
                                    <h4><i class="icon fa fa-warning"></i> Cảnh báo!</h4>
                                    Bạn có chắc chắn muốn xóa bình luận này không? Hành động này không thể hoàn tác.
                                </div>

                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        <h3 class="panel-title">Thông tin bình luận</h3>
                                    </div>
                                    <div class="panel-body">
                                        <table class="table table-bordered">
                                            <tr>
                                                <th>Mã bình luận</th>
                                                <td>@Model.MABL</td>
                                            </tr>
                                            <tr>
                                                <th>Sản phẩm</th>
                                                <td>@Model.TENSP</td>
                                            </tr>
                                            <tr>
                                                <th>Khách hàng</th>
                                                <td>@Model.TENKH</td>
                                            </tr>
                                            <tr>
                                                <th>Nội dung</th>
                                                <td>@Model.NOIDUNG</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div class="text-center">
                                    <a href="/Admin/HoTro/DeleteHoTro?Id=@Model.MABL" class="btn btn-danger">
                                        <i class="glyphicon glyphicon-trash"></i> Xác nhận xóa
                                    </a>
                                    <a href="/Admin/HoTro/LietKeHoTro" class="btn btn-default">
                                        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
