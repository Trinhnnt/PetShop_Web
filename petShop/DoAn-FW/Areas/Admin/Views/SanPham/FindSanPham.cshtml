@model IEnumerable<Web_projectframeword_admin.Models.SanPham>
@{
    int pages = Convert.ToInt32(ViewData["pages"] ?? 1);
    int p = Convert.ToInt32(ViewData["page"] ?? 1);
    string ten = ViewData["ten"]?.ToString() ?? "";
}
@{
    <div class="content-wrapper" style="min-height: 639px;">
        <section class="content-header">
            <h1>
                <i class="glyphicon glyphicon-phone"></i>Danh sách sản phẩm
            </h1>
            <div class="breadcrumb">
                <form id="searchForm" action="/Admin/SanPham/FindSanPham" method="post">
                    <div class="searchbox">
                        <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm" name="ten" value="@ten">
                        <button type="submit" id="searchButton" style="width: 50px; height: 25px; background-color: darkcyan; border-radius: 10px; color: white; border-color: white; ">
                            <i class="fas fa-search-location"></i>
                        </button>
                    </div>
                    <a class="btn btn-primary btn-sm" href="/Admin/SanPham/EnterSanPham" role="button">
                        <span class="glyphicon glyphicon-plus"></span>Thêm sản phẩm
                    </a>
                </form>
            </div>
        </section>
        <section class="content">
            <div class="row">
                <div class="col-md-12">
                    <div class="box" id="view">
                        <div class="box-header with-border">
                            @if (!string.IsNullOrEmpty(ten))
                            {
                                <div class="alert alert-info">
                                    <p>Kết quả tìm kiếm cho: <strong>@ten</strong></p>
                                </div>
                            }
                            <div class="box-body">
                                <div class="row" style="padding:0px; margin:0px; height: 1000px;">
                                    <div class="table-responsive">
                                        @if (Model != null && Model.Any())
                                        {
                                            <table class="table table-hover table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th class="text-center" style="width:70px">Mã TTSP</th>
                                                        <th>Tên sản phẩm</th>
                                                        <th>Hình ảnh</th>
                                                        <th>Loại sản phẩm</th>
                                                        <th>Thương hiệu</th>
                                                        <th>Số lượng</th>
                                                        <th class="text-center" colspan="2">Thao tác</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td class="text-center">@item.MaTTSP</td>
                                                            <td style="font-size: 16px;">@item.TenSP</td>
                                                            <td style="width:120px">
                                                                <img src="@item.HinhAnh" alt="@item.TenSP" class="img-responsive">
                                                            </td>
                                                            <td>@item.TenLoaiSP</td>
                                                            <td>@item.TenTH</td>
                                                            <td>@item.SoLuong</td>
                                                            <td class="text-center">
                                                                <a class="btn btn-success btn-xs" href="/Admin/SanPham/ViewSanPham?Id=@item.MaTTSP" role="button">
                                                                    <span class="glyphicon glyphicon-edit"></span>Sửa
                                                                </a>
                                                            </td>
                                                            <td class="text-center">
                                                                <a class="btn btn-danger btn-xs" href="/Admin/SanPham/DeleteSanPham?Id=@item.MaTTSP&page=@p" onclick="return confirm('Xác nhận xóa sản phẩm này ?')" role="button">
                                                                    <span class="glyphicon glyphicon-trash"></span>Xóa
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning">
                                                <p>Không tìm thấy sản phẩm phù hợp với từ khóa: <strong>@ten</strong></p>
                                                <a href="/Admin/SanPham/LietKeSanPham" class="btn btn-default">
                                                    <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (pages > 1)
            {
                <div class="row">
                    <div class="col-md-12 text-center">
                        <ul class="pagination">
                            <form action="/Admin/SanPham/FindSanPham" method="get">
                                <input type="hidden" name="ten" value="@ten" />
                                <input type="submit" value="Go to" /> page <input type="number" max="@pages" min="1" name="page" value="@p" /> of @pages
                            </form>
                        </ul>
                    </div>
                </div>
            }
        </section>
    </div>
    <script>
        // Hàm kiểm tra trước khi submit form tìm kiếm
        function validateSearch() {
            var searchValue = document.getElementById('searchInput').value.trim();
            if (searchValue === '') {
                // Nếu không có dữ liệu nhập vào, ngăn chặn submit form
                return false;
            }
            return true;
        }

        // Hàm kiểm tra trước khi submit form phân trang
        function validatePageSearch() {
            var pageValue = document.getElementById('pageInput').value.trim();
            if (pageValue === '' || parseInt(pageValue) < 1 || parseInt(pageValue) > @pages) {
                return false;
            }
            return true;
        }

        // Thêm sự kiện cho nút tìm kiếm
        document.addEventListener('DOMContentLoaded', function() {
            var searchButton = document.getElementById('searchButton');
            var searchInput = document.getElementById('searchInput');

            // Thêm sự kiện khi nhấn Enter trong ô tìm kiếm
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    if (searchInput.value.trim() === '') {
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}
