@using Web_projectframeword_admin.Models;
@{
    ViewData["Title"] = "Quản lý thương hiệu";
    List<ThuongHieu> ListTH = new List<ThuongHieu>();
    ListTH = ViewBag.DSTH as List<ThuongHieu>;
}

<div class="content-wrapper" style="min-height: 639px;">
    <section class="content-header">
        <h1>
            <i class="fa fa-trademark"></i> Quản lý thương hiệu
        </h1>
        <div class="breadcrumb">
            <a class="btn btn-primary btn-sm" href="/Admin/SanPham/LietKeSanPham" role="button">
                <span class="glyphicon glyphicon-remove do_nos"></span> Quay lại
            </a>
        </div>
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box" id="view">
                    <div class="box-header with-border">
                        <div class="box-body">
                            @if (TempData["thongbao"] != null)
                            {
                                <div class="alert alert-success">
                                    @TempData["thongbao"]
                                </div>
                            }

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <form action="/Admin/SanPham/InsertTH" method="get" class="form-inline">
                                            <div class="input-group">
                                                <input type="text" name="TENTH" class="form-control" placeholder="Tên thương hiệu" required>
                                                <span class="input-group-btn">
                                                    <button class="btn btn-primary" type="submit">
                                                        <span class="glyphicon glyphicon-plus"></span> Thêm thương hiệu
                                                    </button>
                                                </span>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 50px;">ID</th>
                                            <th>Tên thương hiệu</th>
                                            <th class="text-center" style="width: 120px;">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (var item in ListTH)
                                        {
                                            i++;
                                            <tr>
                                                <td class="text-center">@i</td>
                                                <td>@item.TENTH</td>
                                                <td class="text-center">
                                                    <a class="btn btn-danger btn-xs" onclick="return confirm('Xác nhận xóa thương hiệu này?')" href="/Admin/SanPham/DeleteTH?Id=@item.TENTH" role="button">
                                                        <span class="glyphicon glyphicon-trash"></span> Xóa
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
