                                                        @{
                                                            if (Model.MaLoaiSP == 1)
                                                            {
                                                                <option value="MALOAISP">[--Chọn loại sản phẩm--]</option>
                                                                <option value="1" selected>Thức ăn cho chó</option>
                                                                <option value="2">Thức ăn cho mèo</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="MALOAISP">[--Chọn loại sản phẩm--]</option>
                                                                <option value="1">Thức ăn cho chó</option>
                                                                <option value="2" selected>Thức ăn cho mèo</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-6" style="padding-right: 0px;">
