                                                                <option value="4" selected>Furminator</option>
                                                                <option value="5">Catsan</option>
                                                                <option value="6">Ferplast</option>
                                                                <option value="7">Whimzees</option>
                                                                <option value="8">Kong</option>
                                                                <option value="9">Bio-Groom</option>
                                                                <option value="10">Tetra</option>
                                                            }
                                                            else if (Model.MaTH == 5)
                                                            {
                                                                <option value="MATH">[--Chọn thương hiệu--]</option>
                                                                <option value="1">Royal Canin</option>
                                                                <option value="2">Pedigree</option>
                                                                <option value="3">Whiskas</option>
                                                                <option value="4">Furminator</option>
                                                                <option value="5" selected>Catsan</option>
                                                                <option value="6">Ferplast</option>
                                                                <option value="7">Whimzees</option>
                                                                <option value="8">Kong</option>
                                                                <option value="9">Bio-Groom</option>
                                                                <option value="10">Tetra</option>
                                                            }
                                                            else if (Model.MaTH == 6)
                                                            {
                                                                <option value="MATH">[--Chọn thương hiệu--]</option>
                                                                <option value="1">Royal Canin</option>
                                                                <option value="2">Pedigree</option>
                                                                <option value="3">Whiskas</option>
                                                                <option value="4">Furminator</option>
                                                                <option value="5">Catsan</option>
                                                                <option value="6" selected>Ferplast</option>
                                                                <option value="7">Whimzees</option>
                                                                <option value="8">Kong</option>
                                                                <option value="9">Bio-Groom</option>
                                                                <option value="10">Tetra</option>

                                                            }
                                                            else if (Model.MaTH == 7)
                                                            {
                                                                <option value="MATH">[--Chọn thương hiệu--]</option>
                                                                <option value="1">Royal Canin</option>
                                                                <option value="2">Pedigree</option>
                                                                <option value="3">Whiskas</option>
                                                                <option value="4">Furminator</option>
                                                                <option value="5">Catsan</option>
                                                                <option value="6">Ferplast</option>
