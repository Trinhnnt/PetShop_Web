@model List<object>
@{
    ViewData["Title"] = "Danh sách sản phẩm Mua";
    List<object> ListSP = ViewData["ListSP"] as List<object>;
    long SoLuong = 0;
    long Gia = 0;
}

<style>
    :root {
        --primary-color: #1b7c55;
        --secondary-color: #ffffff;
        --border-color: #e9eff1;
        --text-color: #212529;
        --light-gray: #f5f7fa;
        --hover-color: #f1f1f1;
        --danger-color: #dc3545;
        --accent-color: #e4572e;
    }

    body {
        background: var(--light-gray);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .mainmenu-area {
        background-color: var(--primary-color) !important;
        padding: 15px 0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        margin-bottom: 40px;
    }

        .mainmenu-area .nav {
            display: flex;
            justify-content: flex-start;
            gap: 40px;
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

            .mainmenu-area .nav > li > a {
                color: white !important;
                font-weight: 600;
                padding: 10px 15px;
                display: inline-block;
                text-align: center;
                white-space: nowrap;
                text-decoration: none;
                text-transform: uppercase;
                font-size: 14px;
            }

                .mainmenu-area .nav > li > a:hover {
                    background-color: #166947 !important;
                    color: #ffffff !important;
                }

            .mainmenu-area .nav > li.active > a {
                background-color: #166947 !important;
            }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 20px 0;
        color: var(--primary-color);
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 22px;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

        .product-table th {
            border: 1px solid var(--border-color);
            padding: 12px 18px;
            background: #f4f6f5;
            font-weight: 600;
            text-align: left;
        }

        .product-table td {
            border: 1px solid var(--border-color);
            padding: 12px 18px;
            vertical-align: middle;
        }

    .product-image {
        width: 80px;
        height: 80px;
        object-fit: contain;
    }

    .product-name {
        font-weight: 600;
        color: var(--primary-color);
        text-decoration: none;
    }

    .product-details {
        font-size: 14px;
        color: #666;
        margin-top: 4px;
    }

    .amount {
        font-weight: 600;
        color: var(--primary-color);
    }

    .detail-button {
        display: inline-block;
        background: var(--accent-color);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        line-height: 36px;
        color: #fff;
        text-align: center;
        font-size: 18px;
    }

    .text-center {
        text-align: center;
    }

    .empty-message {
        text-align: center;
        color: #888;
        padding: 30px;
    }
</style>

<!-- Link to FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

<div class="mainmenu-area">
    <div class="container">
        <div class="row">
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>
                        <a href="/Home/Index">TRANG CHỦ</a>
                    </li>
                    <li>
                        <a href="/TaiKhoan/ThongTinTK">THÔNG TIN CÁ NHÂN</a>
                    </li>
                    <li>
                        <a href="/HoaDon/LichSuHD">QUẢN LÝ ĐƠN HÀNG CÁ NHÂN</a>
                    </li>
                    <li class="active"><a href="/DSSPMua/DSSPMua">SẢN PHẨM ĐÃ MUA</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End mainmenu area -->

<div class="container">
    <div class="page-header">
        <h2 class="page-title">Sản phẩm đã mua</h2>
    </div>

    <table class="product-table">
        <thead>
            <tr>
                <th>Hình ảnh sản phẩm</th>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Xem chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @if (ListSP != null && ListSP.Count > 0)
            {
                foreach (var ctsp in ListSP)
                {
                    // Lấy thông tin sản phẩm
                    string maTTSP = ctsp.GetType().GetProperty("MaTTSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string maLoaiSP = ctsp.GetType().GetProperty("MaLoaiSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string tenSP = ctsp.GetType().GetProperty("TenSP")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string tenTH = ctsp.GetType().GetProperty("TenTH")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string khoiLuong = ctsp.GetType().GetProperty("KhoiLuong")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string xuatXu = ctsp.GetType().GetProperty("XuatXu")?.GetValue(ctsp, null)?.ToString() ?? "";
                    string hinhAnh = ctsp.GetType().GetProperty("HinhAnh")?.GetValue(ctsp, null)?.ToString() ?? "";

                    if (long.TryParse(ctsp.GetType().GetProperty("GiaKM")?.GetValue(ctsp, null)?.ToString(), out long giaKM) && giaKM > 0)
                        Gia = giaKM;
                    else
                        Gia = long.TryParse(ctsp.GetType().GetProperty("Gia")?.GetValue(ctsp, null)?.ToString(), out long gia) ? gia : 0;

                    SoLuong = long.TryParse(ctsp.GetType().GetProperty("SoLuong")?.GetValue(ctsp, null)?.ToString(), out long soLuong) ? soLuong : 0;
                    <tr>
                        <!-- Hình ảnh sản phẩm -->
                        <td class="text-center">
                            <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP">
                                <img class="product-image" alt="Product Image" src="@hinhAnh" />
                            </a>
                        </td>
                        <!-- Thông tin sản phẩm -->
                        <td>
                            <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP" class="product-name">
                                @tenSP
                            </a>
                            
                        </td>
                        <!-- Giá -->
                        <td>
                            <span class="amount">@string.Format("{0:0,0 đ}", Gia)</span>
                        </td>
                        <!-- Số lượng -->
                        <td>
                            @SoLuong
                        </td>
                        <!-- Xem chi tiết (icon con mắt) -->
                        <td class="text-center">
                            <a href="/SanPham/ChiTietSP?t=@maTTSP&l=@maLoaiSP" title="Xem chi tiết" class="detail-button">
                                <i class="fa fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-message">Không có sản phẩm đã mua.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
