<div class="product-big-title-area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="product-bit-title page-title-container">
                    <h2>Đăng ký thành viên PetShop</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Page title area -->

<div class="single-product-area">
    <div class="container">
        <div class="row">
            <div class="col-md-10 col-md-offset-1">
                <div class="register-box">
                    <div class="register-box-inner">
                        <h2 class="sidebar-title">THÔNG TIN ĐĂNG KÝ</h2>
                        <hr />
                        <form action="/TaiKhoan/ThemTK" method="post" class="dangki" onsubmit="validateForm(event)">
                            <div class="form-row">
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="TenKH"><i class="fa fa-user"></i> Họ tên:</label>
                                        <input name="TenKH" type="text" class="form-control" id="TenKH" placeholder="Nhập tên của bạn vào đây" />
                                        <span id="TenKH-error" class="error-message"></span>
                                    </div>
                                </div>
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="GioiTinh"><i class="fa fa-venus-mars"></i> Giới tính:</label>
                                        <select name="GioiTinh" class="form-control" id="GioiTinh">
                                            <option value="Nam">Nam</option>
                                            <option value="Nữ">Nữ</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="SDT"><i class="fa fa-phone"></i> SDT:</label>
                                        <input name="SDT" type="text" class="form-control" id="SDT" placeholder="09xxxxxxxx" />
                                        <span id="SDT-error" class="error-message"></span>
                                    </div>
                                </div>
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="Email"><i class="fa fa-envelope"></i> Email:</label>
                                        <input name="Email" type="email" class="form-control" id="Email" placeholder="example@gmail.com" />
                                        <span id="Email-error" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="CMND"><i class="fa fa-id-card"></i> CMND hoặc CCCD:</label>
                                        <input name="CMND" type="text" class="form-control" id="CMND" placeholder="" />
                                        <span id="CMND-error" class="error-message"></span>
                                    </div>
                                </div>
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="DiaChi"><i class="fa fa-map-marker"></i> Địa chỉ:</label>
                                        <input name="DiaChi" type="text" class="form-control" id="DiaChi" placeholder="Nhập địa chỉ" />
                                        <span id="DiaChi-error" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="MatKhau"><i class="fa fa-lock"></i> Mật khẩu:</label>
                                        <input name="MatKhau" type="password" class="form-control" id="MatKhau" placeholder="Nhập mật khẩu" oninput="checkPasswordStrength(this.value)" />
                                        <div class="password-strength-container">
                                            <div class="password-strength-meter">
                                                <div id="password-strength-bar" class="password-strength-bar"></div>
                                            </div>
                                            <div class="password-info-row">
                                                <div id="password-tips"></div>
                                                <span id="password-strength-text" class="strength-text"></span>
                                            </div>
                                        </div>
                                        <span id="MatKhau-error" class="error-message"></span>
                                    </div>
                                </div>
                                <div class="form-column">
                                    <div class="form-group">
                                        <label for="confirm-pass"><i class="fa fa-lock"></i> Nhập lại mật khẩu:</label>
                                        <input name="confirm-pass" type="password" class="form-control" id="confirm-pass" placeholder="Nhập lại mật khẩu" oninput="check(this)" />
                                        <span id="confirm-pass-error" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="message"></div>
                            <div class="btn-container">
                                <input type="submit" value="ĐĂNG KÍ NGAY" class="btn btn-register" />
                                <p class="login-link">
                                    Đã có tài khoản? <a href="/TaiKhoan/DangNhap">Đăng nhập</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
