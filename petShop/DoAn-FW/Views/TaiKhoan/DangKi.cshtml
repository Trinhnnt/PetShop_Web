@{
    ViewData["Title"] = "Đăng kí";
}
<script>
    function check(input) {
        if (input.value != document.getElementById('MatKhau').value) {
            input.setCustomValidity("Mật khẩu không khớp");
            document.getElementById('confirm-pass-error').textContent = "Mật khẩu không khớp";
        } else {
            input.setCustomValidity("");
            document.getElementById('confirm-pass-error').textContent = "";
        }
    }

    // Hàm đánh giá độ mạnh của mật khẩu
    function checkPasswordStrength(password) {
        let strength = 0;
        let tips = [];

        if (password.length < 6) {
            tips.push("Cần ít nhất 6 ký tự");
        } else {
            strength += 1;
        }
        if (password.match(/[a-z]+/)) {
            strength += 1;
        } else {
            tips.push("Thêm chữ cái thường");
        }
        if (password.match(/[A-Z]+/)) {
            strength += 1;
        } else {
            tips.push("Thêm chữ cái HOA");
        }
        if (password.match(/[0-9]+/)) {
            strength += 1;
        } else {
            tips.push("Thêm chữ số");
        }
        if (password.match(/[^a-zA-Z0-9]+/)) {
            strength += 1;
        } else {
            tips.push("Thêm ký tự đặc biệt");
        }

        const passwordStrengthBar = document.getElementById("password-strength-bar");
        const passwordStrengthText = document.getElementById("password-strength-text");
        const passwordTips = document.getElementById("password-tips");

        passwordStrengthBar.style.width = (strength * 20) + "%";

        if (password.length === 0) {
            passwordStrengthBar.className = "password-strength-bar";
            passwordStrengthText.textContent = "";
            passwordTips.innerHTML = "";
            return;
        } else if (strength < 2) {
            passwordStrengthBar.className = "password-strength-bar strength-weak";
            passwordStrengthText.textContent = "Yếu";
            passwordStrengthText.className = "strength-text text-danger";
        } else if (strength < 4) {
            passwordStrengthBar.className = "password-strength-bar strength-medium";
            passwordStrengthText.textContent = "Trung bình";
            passwordStrengthText.className = "strength-text text-warning";
        } else {
            passwordStrengthBar.className = "password-strength-bar strength-strong";
            passwordStrengthText.textContent = "Mạnh";
            passwordStrengthText.className = "strength-text text-success";
        }

        passwordTips.innerHTML = tips.length > 0 ?
            "<small>Gợi ý: " + tips.join(", ") + "</small>" :
            "<small class='text-success'>Mật khẩu tốt!</small>";
    }

    // Kiểm tra form trước khi submit
    function validateForm(event) {
        event.preventDefault();
        let isValid = true;

        // Danh sách các trường bắt buộc
        const requiredFields = [
            { id: 'TenKH', name: 'Họ tên', errorId: 'TenKH-error' },
            { id: 'SDT', name: 'Số điện thoại', errorId: 'SDT-error' },
            { id: 'Email', name: 'Email', errorId: 'Email-error' },
            { id: 'CMND', name: 'CMND hoặc CCCD', errorId: 'CMND-error' },
            { id: 'DiaChi', name: 'Địa chỉ', errorId: 'DiaChi-error' },
            { id: 'MatKhau', name: 'Mật khẩu', errorId: 'MatKhau-error' },
            { id: 'confirm-pass', name: 'Xác nhận mật khẩu', errorId: 'confirm-pass-error' }
        ];

        // Reset tất cả thông báo lỗi
        document.querySelectorAll('.error-message').forEach(el => {
            el.textContent = '';
        });

        // Kiểm tra từng trường
        requiredFields.forEach(field => {
            const input = document.getElementById(field.id);
            const errorElement = document.getElementById(field.errorId);

            if (!input.value.trim()) {
                errorElement.textContent = `Bạn phải nhập ${field.name} trước khi đăng ký`;
                isValid = false;
            }
        });

        // Kiểm tra mật khẩu xác nhận
        const password = document.getElementById('MatKhau').value;
        const confirmPass = document.getElementById('confirm-pass').value;
        if (password && confirmPass && password !== confirmPass) {
            document.getElementById('confirm-pass-error').textContent = "Mật khẩu không khớp";
            isValid = false;
        }

        // Nếu hợp lệ thì submit form
        if (isValid) {
            document.querySelector('form.dangki').submit();
        }
    }
</script>
<style>
    /* PetShop style inspired */
    body {
        background: #f6f7fb;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Màu sắc chính của PetShop logo */
    :root {
        --petshop-orange: #FF8C00;
        --petshop-green: #4CAF50;
        --petshop-light-green: #8BC34A;
    }

    /* Reset tất cả container */
    .container, .container-fluid, .row, .col-md-12 {
        width: 100%;
        max-width: 100%;
        padding: 0;
        margin: 0;
    }

    .mainmenu-area {
        background-color: #117a39;
        padding: 15px 0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .navbar-nav li a {
        color: #fff !important;
        font-weight: 500;
        padding: 12px 18px;
        transition: background 0.2s;
        font-size: 16px;
        background: none !important;
    }

        .navbar-nav li a:hover,
        .navbar-nav li.active a {
            color: var(--petshop-orange) !important;
            background: none !important;
        }

    .product-big-title-area {
        background: #f6f7fb;
        padding: 32px 0 14px 0;
        margin-bottom: 0;
        box-shadow: none;
    }

        .product-big-title-area .product-bit-title h2 {
            color: #333;
            font-size: 40px;
            font-weight: 700;
            text-align: center;
            text-transform: none;
            margin: 0 0 12px 0;
            letter-spacing: 0;
            position: relative;
            display: inline-block;
        }

            .product-big-title-area .product-bit-title h2:before {
                content: "🐾";
                margin-right: 10px;
                color: var(--petshop-orange);
            }

    .page-title-container {
        text-align: center;
    }

    .single-product-area {
        background: #f6f7fb;
        padding: 0;
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        width: 100%;
    }

    /* Điều chỉnh khung đăng ký để chiếm toàn bộ chiều rộng */
    .register-box {
        position: relative;
        background-color: rgba(255, 255, 255, 0.85);
        box-shadow: none;
        padding: 0;
        width: 100%;
        margin: 0;
        max-width: 100%;
        overflow: hidden;
        background-image: url("https://i.pinimg.com/736x/a9/9c/54/a99c5416707b4ded43051f56b4a4d838.jpg");
        background-size: cover;
        background-position: center;
        border-radius: 0;
    }

    .register-box-inner {
        background-color: rgba(255, 255, 255, 0.9);
        padding: 40px 20px;
        width: 100%;
        box-sizing: border-box;
    }

    .sidebar-title {
        color: var(--petshop-green);
        font-size: 34px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        text-transform: uppercase;
        position: relative;
        display: inline-block;
        left: 50%;
        transform: translateX(-50%);
    }

        .sidebar-title:before {
            content: "🐾";
            margin-right: 10px;
            color: var(--petshop-orange);
        }

    .register-box hr {
        border-top: 2px solid var(--petshop-light-green);
        margin: 15px 0 25px 0;
        opacity: 0.5;
    }

    /* Bố trí 2 thuộc tính trên 1 hàng với kích thước lớn hơn */
    .form-row {
        display: flex;
        justify-content: space-between;
        margin: 0 0 25px 0;
        width: 100%;
    }

    .form-column {
        flex: 0 0 49%;
        padding: 0;
    }

    .form-group {
        margin-bottom: 20px;
        position: relative;
        width: 100%;
    }

        .form-group label {
            color: var(--petshop-green);
            font-weight: 600;
            font-size: 22px;
            margin-bottom: 12px;
            display: block;
        }

        .form-group i {
            margin-right: 8px;
            color: var(--petshop-orange);
        }

    .form-control {
        border-radius: 10px;
        border: 3px solid #e6e8ec;
        padding: 10px 15px;
        background: #fff;
        font-size: 20px;
        width: 100%;
        box-sizing: border-box;
        transition: all 0.3s;
        height: 70px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

        .form-control:focus {
            border-color: var(--petshop-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.2);
        }

    select.form-control {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
        color: #333;
        background-color: #fff;
    }

    /* Đảm bảo nút submit ở giữa và to hơn */
    .btn-container {
        text-align: center;
        margin-top: 40px;
        width: 100%;
    }

    .btn-register {
        background: var(--petshop-green) !important;
        border: none;
        border-radius: 40px;
        padding: 20px 0;
        color: #fff;
        font-weight: 700;
        font-size: 24px;
        letter-spacing: 1px;
        width: 100%;
        max-width: 400px;
        text-align: center;
        transition: all 0.3s;
        text-transform: uppercase;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(76, 175, 80, 0.3);
    }

        .btn-register:hover {
            background: #3d8b40 !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(76, 175, 80, 0.4);
        }

    .message {
        color: #ff3860;
        font-size: 18px;
        margin: 10px 0;
        font-weight: 600;
        text-align: center;
    }

    .error-message {
        color: #ff3860;
        font-size: 16px;
        margin-top: 8px;
        font-weight: 500;
        display: block;
    }

    .password-strength-container {
        margin-top: 12px;
        margin-bottom: 10px;
    }

    .password-strength-meter {
        height: 10px;
        background-color: #e1e5ea;
        border-radius: 5px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .password-strength-bar {
        height: 100%;
        width: 0;
        transition: width 0.3s, background-color 0.3s;
        border-radius: 5px;
    }

    .strength-weak {
        background-color: #ff3860;
    }

    .strength-medium {
        background-color: #ffdd57;
    }

    .strength-strong {
        background-color: #23d160;
    }

    .strength-text {
        font-size: 16px;
        font-weight: 700;
        margin-left: 5px;
    }

    .text-danger {
        color: #ff3860;
    }

    .text-warning {
        color: #ffaa00;
    }

    .text-success {
        color: #23d160;
    }

    #password-tips {
        font-size: 16px;
        color: #666;
        margin-top: 5px;
    }

    .login-link {
        margin-top: 25px;
        color: #666;
        font-size: 18px;
    }

        .login-link a {
            color: var(--petshop-green);
            font-weight: 600;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
                color: var(--petshop-orange);
            }

    /* Responsive */
    @@media (max-width: 1200px) {
        .form-control

    {
        height: 60px;
        font-size: 18px;
    }

    .form-group label {
        font-size: 20px;
    }

    }

    @@media (max-width: 900px) {
        .form-column

    {
        flex: 0 0 100%;
    }

    .form-row {
        flex-direction: column;
        margin: 0 0 20px 0;
    }

    .register-box-inner {
        padding: 30px 15px;
    }

    }

    @@media (max-width: 600px) {
        .product-big-title-area .product-bit-title h2

    {
        font-size: 28px;
    }

    .sidebar-title {
        font-size: 26px;
    }

    .form-group label {
        font-size: 18px;
    }

    .form-control {
        font-size: 16px;
        height: 50px;
        padding: 10px 12px;
    }

    .btn-register {
        font-size: 20px;
        padding: 15px 0;
        max-width: 90%;
    }

}
</style>
