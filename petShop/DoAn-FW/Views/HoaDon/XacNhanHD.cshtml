@{
    List<CTHD> listcthd = ViewBag.listcthd;
    KhuyenMai KM = new KhuyenMai();
    KM = ViewBag.KM;
    long ThanhTien = 0;
    long TongTien = 0;
    long TTPhaiTra = 0;
    long TienGiam = 0;
    KhachHang KH = ViewBag.KH;
}
<div class="mainmenu-area">
    <div class="container">
        <div class="row">
            <div class="navbar-header">
                <button type="button"
                        class="navbar-toggle"
                        data-toggle="collapse"
                        data-target=".navbar-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li><a href="/Home/Index">Trang chủ</a></li>
                    <li><a href="/SanPham/Products">Sản phẩm</a></li>
                    <li>
                        <a href="/TinTuc/DanhSachTinTuc">Tin tức</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End mainmenu area -->

<style>

    .error-message {
        color: #e74c3c;
        font-size: 14px;
        margin-top: 5px;
        display: block;
    }

    input.error {
        border: 1px solid #e74c3c !important;
    }

    /* Hiệu ứng rung khi có lỗi */
    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(5px);
        }
    }

    .shake {
        animation: shake 0.6s;
    }

    /* Các style mới chỉ áp dụng cho form hóa đơn với màu chủ đạo #008066 */
    .invoice-form {
        max-width: 800px;
        margin: 40px auto;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        overflow: hidden;
        font-family: 'Montserrat', sans-serif;
    }

        .invoice-form header {
            background: #008066; /* Màu chủ đạo */
            color: #fff;
            padding: 20px;
            text-align: center;
        }

            .invoice-form header h1 {
                margin: 0;
                font-size: 28px;
                font-weight: 800;
            }

        .invoice-form .content {
            padding: 20px 30px 30px 30px;
        }

            .invoice-form .content h2 {
                text-align: center;
                font-size: 22px;
                color: #008066; /* Màu chủ đạo */
                margin-bottom: 20px;
            }

        .invoice-form table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

            .invoice-form table th,
            .invoice-form table td {
                padding: 12px;
                border-bottom: 1px solid #eee;
                text-align: left;
            }

            .invoice-form table th {
                background-color: #008066; /* Màu chủ đạo */
                color: #fff;
                font-weight: 600;
            }

        .invoice-form .summary-table td {
            border-top: 2px solid #eee;
            padding: 10px;
            font-weight: 600;
        }

        .invoice-form .final-total {
            color: #008066; /* Màu chủ đạo */
            background-color: #fafafa;
            border-top: 2px solid #eee;
            border-bottom: 2px solid #eee;
        }

        .invoice-form .summary {
            background: #fafafa;
            padding: 15px;
            border-top: 2px solid #eee;
            border-bottom: 2px solid #eee;
            font-weight: 600;
            color: #008066; /* Màu chủ đạo */
            text-align: right;
            margin-bottom: 20px;
        }

        .invoice-form .form-group {
            margin-bottom: 20px;
        }

            .invoice-form .form-group label {
                display: block;
                font-weight: 600;
                margin-bottom: 8px;
                color: #333;
            }

            .invoice-form .form-group input[type="text"] {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 4px;
                font-family: inherit;
            }

        .invoice-form .btn-submit {
            display: block;
            width: 100%;
            background-color: #008066; /* Màu chủ đạo */
            color: #fff;
            padding: 15px;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.3s;
            text-align: center;
        }

            .invoice-form .btn-submit:hover {
                background-color: #006a55; /* Màu đậm hơn khi hover */
                transform: translateY(-2px);
            }
</style>

<div class="invoice-form">
    
    <div class="content">
        <h2>Vui lòng kiểm tra lại thông tin!</h2>
        <form action="/HoaDon/InsertHD" method="post">
            <table>
                <thead>
                    <tr>
                        <th style="width: 60%;">Tên sản phẩm</th>
                        <th style="width: 15%;">Số lượng</th>
                        <th style="width: 25%;">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listcthd)
                    {
                        <tr>
                            <td>
                                <input name="MaTTSP[]" type="hidden" value="@item.MaTTSP" />
                                <input name="MaKM" type="hidden" value="@KM.MaKM" />
                                @item.TenSP
                            </td>
                            <td>
                                @item.SoLuong
                                <input name="SoLuong[]" type="hidden" value="@item.SoLuong" />
                            </td>
                            @{
                                ThanhTien = item.Gia * item.SoLuong;
                                TongTien += ThanhTien;
                            }
                            <td>@string.Format("{0:0,0 đ}", ThanhTien)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <table class="summary-table">
                <tr>
                    <td style="width: 75%; font-weight: 600; border-top: 2px solid #eee;">Tổng tiền sản phẩm</td>
                    <td style="width: 25%; border-top: 2px solid #eee;">@string.Format("{0:0,0 đ}", TongTien)</td>
                </tr>
                <tr>
                    @{
                        if (KM.TTienToiThieu <= TongTien)
                        {
                            TienGiam = (TongTien * KM.SoPTKM) / 100;
                            TTPhaiTra = TongTien - TienGiam;
                        }
                        else
                        {
                            TTPhaiTra = TongTien;
                        }
                    }
                    <td style="width: 75%; font-weight: 600;">Giảm</td>
                    <td style="width: 25%;">@string.Format("{0:0,0 đ}", TienGiam)</td>
                </tr>
            </table>

            <div class="summary">
                Tổng tiền phải thanh toán: @string.Format("{0:0,0 đ}", TTPhaiTra)
            </div>

            <tr>
                <td align="left" style="padding-top: 0px;">
                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                        <tr style="color: #008066;">
                            <!-- Màu chủ đạo -->
                            <td width="75%" align="left" style="font-family: 'Times New Roman', Times, serif; font-size: 18px; font-weight: 800; line-height: 24px; padding: 10px; border-top: 3px solid #eeeeee; border-bottom: 3px solid #eeeeee;">
                                Tổng tiền phải thanh toán
                            </td>
                            <td width="25%" align="left" style="font-family: 'Times New Roman', Times, serif; font-size: 16px; font-weight: 800; line-height: 24px; padding: 10px; border-top: 3px solid #eeeeee; border-bottom: 3px solid #eeeeee;"> @string.Format("{0:0,0 đ}", TTPhaiTra) </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td align="left" height="100%" valign="top" width="100%" style="padding: 0 35px 0px 35px; background-color: #ffffff;" bgcolor="#ffffff">
                    <div style="display:inline-block; max-width:100%; min-width:240px; vertical-align:top; width:100%;">
                        <table align="left" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:530px;">
                            <tr>
                                <td align="left" valign="top" style="font-family: 'Times New Roman', Times, serif; font-size: 16px; font-weight: 400; line-height: 24px; ">
                                    <div class="form-group">
                                        <p style="font-weight: 800; font-size: 18px; color: #008066;">Địa chỉ giao hàng <span style="color: red;">*</span></p> <!-- Màu chủ đạo -->
                                        <input type="text" name="DiaChi" id="DiaChi" class="form-control" placeholder="Nhập địa chỉ giao hàng" />
                                        <span id="diaChiError" style="color: red; display: none;">Vui lòng nhập địa chỉ giao hàng</span>
                                    </div>

                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                <td align="left" height="100%" valign="top" width="100%" style="padding: 0 35px 35px 35px; background-color: #ffffff;" bgcolor="#ffffff">
                    <div style="display:inline-block; max-width:100%; min-width:240px; vertical-align:top; width:100%;">
                        <table align="left" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:300px;">
                            <tr>
                                <td align="left" height="100%" valign="top" width="100%" style="padding: 0 35px 0px 35px; background-color: #ffffff;" bgcolor="#ffffff">
                                    <div style="display:inline-block; max-width:100%; min-width:240px; vertical-align:top; width:100%;">
                                        <table align="left" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:530px;">
                                            <tr>
                                                <td align="left" valign="top" style="font-family: 'Times New Roman', Times, serif; font-size: 16px; font-weight: 400; line-height: 24px; ">
                                                    <p style="font-weight: 800; font-size: 18px; color: #008066;">Ngày lập hóa đơn:</p> <!-- Màu chủ đạo -->
                                                    <p>@DateTime.Now.ToString("dd-MM-yyyy")</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>

                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                <td align="center" style="border-radius: 5px;" bgcolor="white">
                    <input type="submit" value="Xác nhận" style="font-size: 18px; font-family: 'Times New Roman', Times, serif; color: #ffffff; text-decoration: none; border-radius: 5px; background-color: #008066; padding: 15px 30px; border: 0px solid #008066; display: block;"> <!-- Màu chủ đạo -->
                </td>
            </tr>
        </form>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Lấy form element
        const form = document.querySelector('form');

        // Thêm sự kiện khi submit form
        form.addEventListener('submit', function(event) {
            // Lấy giá trị địa chỉ
            const diaChiInput = document.getElementById('DiaChi');
            const diaChiError = document.getElementById('diaChiError');

            // Kiểm tra nếu địa chỉ trống
            if (!diaChiInput.value.trim()) {
                // Hiển thị thông báo lỗi
                diaChiError.style.display = 'block';
                // Thêm viền đỏ cho input
                diaChiInput.style.border = '1px solid #e74c3c';
                diaChiInput.classList.add('error');

                // Thêm hiệu ứng rung
                diaChiInput.classList.add('shake');
                setTimeout(() => {
                    diaChiInput.classList.remove('shake');
                }, 600);

                // Ngăn form submit
                event.preventDefault();

                // Cuộn lên vị trí của input địa chỉ
                diaChiInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                // Focus vào input
                diaChiInput.focus();
            } else {
                // Ẩn thông báo lỗi nếu đã nhập địa chỉ
                diaChiError.style.display = 'none';
                diaChiInput.classList.remove('error');
            }
        });

        // Thêm sự kiện khi người dùng nhập vào input để ẩn thông báo lỗi
        document.getElementById('DiaChi').addEventListener('input', function() {
            if (this.value.trim()) {
                document.getElementById('diaChiError').style.display = 'none';
                this.classList.remove('error');
            }
        });
    });
</script>
