@using Web_projectframeword_admin.Models;
@model NhapHang

@{
    bool isPaid = Model.TINHTRANGTT == 1;
    bool isUnpaid = Model.TINHTRANGTT == 0;
}

@section Click_CTPN {
    <script type="text/javascript">
        $(function () {
            $('#tbl_ctpn tr').click(function (e) {
                var masp = $(this).closest('.onRow').find('td:nth-child(2)').text();
                var gianhap = $(this).closest('.onRow').find('td:nth-child(4)').text();
                var sl = $(this).closest('.onRow').find('td:nth-child(5)').text();
                $('#spSL').val(masp);
                $('#gnIP').val(gianhap);
                $('#slIP').val(sl);
            });

            // Validate on submit
            $('form').submit(function (e) {
                var isPaid = @Model.TINHTRANGTT == 1 ? true : false;
                // Chỉ kiểm tra khi chưa thanh toán
                if (!isPaid) {
                    var ncc = $('[name="MANCC"]').val();
                    var nv = $('[name="MANV"]').val();
                    if (!ncc || !nv) {
                        alert("Vui lòng chọn nhà cung cấp và nhân viên!");
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}
